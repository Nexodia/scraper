# Price Spike — example environment.
# Copy to .env and fill GOOGLE_API_KEY. Never commit the real .env.

GOOGLE_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# MCP facade of the scraper service
SCRAPER_MCP_URL=http://127.0.0.1:8101/mcp

# Sonepar (Checkbuy) auth — fill after running scripts/sonepar_login.py
SONEPAR_REFRESH_TOKEN=
SONEPAR_CLIENT_ID=
SONEPAR_USER_ID=
